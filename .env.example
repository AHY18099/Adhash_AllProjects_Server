# Email Configuration
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-email@zohomail.com
EMAIL_PASSWORD=your-app-password
EMAIL_TO=recipient@example.com

# Slack Configuration
# Bot token (xoxb-...) and channel ID/name for AutoChecker down alerts
SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_CHANNEL=your-slack-channel-id

# Base URL where generated HTML reports are published (e.g. GitHub Pages).
# When set, Slack messages include a "View Report" link to {REPORT_BASE_URL}/latest.html
REPORT_BASE_URL=https://your-org.github.io/your-repo

# Server Configuration - Multiple Servers
# Format: URL|Custom Name (pipe-separated for custom display names)
# Example: https://example.com/|MyProject - Server Name,https://api.example.com/|MyProject - API
SERVER_URLS=http://20.62.109.239:3000/|AutoChecker - PartSouq,http://20.7.146.191:3000/|AutoChecker - Auto Search,http://20.1.198.58/|AutoChecker - Production Server,http://20.15.121.70:3000/|AutoChecker - Manual Search,https://manageadminapi.autochecker.com/|AutoChecker - Admin API,https://managemobileapi.autochecker.com/|AutoChecker - Mobile API,https://ebaydev.autochecker.com/|AutoChecker - eBay API,https://mobileliveapi.wavedin.app/|WavedIn - Mobile API,https://api.zapcrm.io/|Zapcrm - API,https://adhashtech.com/|Adhash - Web,https://humee.com/|Humee - Admin,https://api.humee.com/|Humee - API,https://api.sendmovieclips.com/|SMC - API,https://api.aisignpro.com/|AiSignPro - API,https://spark.synctag.com/|Synctag - API,https://manage.autochecker.com/|AutoChecker - Admin,https://superadmin.wavedin.app/|WavedIn - Super Admin,https://zapcrm.io/|Zapcrm - Admin,https://lead.zapcrm.io/|Zapcrm - Lead,https://gopocket.algomax.co/|Algomax - GoPocket,https://metcalf.ai/|Metcalf - Web,https://admin.aisignpro.com/|AiSignPro - Admin,https://www.ddphub.ai/|DDP URL,https://twfnwlccyudfgqjmmdva.supabase.co/|DDP API
# Optional: always include these even when SERVER_URLS secret is outdated
REQUIRED_SERVER_URLS=https://20.1.198.58/|AutoChecker - Production Server

# Send email only when status changes (true) or every check (false)
SEND_ONLY_ON_CHANGE=false

# Check interval for monitoring (in minutes)
CHECK_INTERVAL_MINUTES=5
